<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/edit_text_bg"
    android:backgroundTint="@color/card_bg"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Hector" />

        <TextView
            android:id="@+id/tv_user_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_grey"
            android:textSize="12sp"
            tools:text="hector@helpdesk.com" />

        <TextView
            android:id="@+id/tv_user_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/priority_medium_text"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="★ 4.7 (12 reviews)" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_user_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@drawable/status_progress_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/status_progress_text"
        android:textSize="11sp"
        tools:text="TECHNICIAN" />

    <ImageView
        android:id="@+id/iv_remove_technician"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="12dp"
        android:contentDescription="@string/admin_remove_technician"
        android:src="@android:drawable/ic_menu_delete"
        android:visibility="gone"
        app:tint="@color/priority_high_text" />

    <Switch
        android:id="@+id/sw_active"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/admin_toggle_active" />

</LinearLayout>
