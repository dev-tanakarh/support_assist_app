<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color"
    tools:context=".MainActivity">

    <!-- Content area - Removed padding here to handle it inside fragments for a better scroll effect -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Floating pill nav bar — a rounded, elevated capsule with margin on
         every side, rather than a bar attached flush to the screen edge.
         Menu is swapped at runtime per role in MainActivity (see
         bottom_nav_menu*.xml) so the same view serves all three roles. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navPillCard"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="32dp"
        app:cardElevation="10dp"
        app:strokeWidth="0dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:itemIconSize="22dp"
            app:itemIconTint="@color/nav_item_color"
            app:itemTextColor="@color/nav_item_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Create Ticket FAB — end-user only (see MainActivity), hidden entirely
         for technician/admin roles who don't create tickets in the web app either. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="92dp"
        android:backgroundTint="@color/primary_blue"
        android:contentDescription="@string/create_new_ticket"
        android:src="@android:drawable/ic_input_add"
        app:maxImageSize="28dp"
        app:elevation="6dp"
        app:tint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
